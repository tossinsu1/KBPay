<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이 폰의 역할"
            android:textStyle="bold"
            android:paddingTop="8dp" />

        <RadioGroup
            android:id="@+id/roleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/roleSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="① 수신기 (폰A) · 문자를 잡아서 전달" />

            <RadioButton
                android:id="@+id/roleReceiver"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="② 표시기 (폰B) · 전달된 문자를 받아 알림" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="페어 코드 (두 폰에 똑같이 입력)"
            android:textStyle="bold"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/pairCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="예: mypair-8271"
            android:inputType="text"
            android:autofillHints="" />

        <LinearLayout
            android:id="@+id/whitelistBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="전달할 발신번호 (쉼표 또는 줄바꿈으로 여러 개)"
                android:textStyle="bold"
                android:paddingTop="12dp" />

            <EditText
                android:id="@+id/whitelist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="예: 1588-1234, 025771000"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:autofillHints="" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="번호 매칭 테스트"
                android:textStyle="bold"
                android:paddingTop="12dp" />

            <EditText
                android:id="@+id/testNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="테스트할 발신번호 입력"
                android:inputType="phone"
                android:autofillHints="" />

            <Button
                android:id="@+id/testBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="매칭 테스트" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp">

            <Button
                android:id="@+id/saveBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="저장 &amp; 시작" />

            <Button
                android:id="@+id/stopBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="중지" />
        </LinearLayout>

        <TextView
            android:id="@+id/listLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="받은 문자"
            android:textStyle="bold"
            android:paddingTop="16dp" />

        <Button
            android:id="@+id/clearBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="목록 비우기" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="200dp"
            android:paddingTop="8dp" />

    </LinearLayout>
</ScrollView>
